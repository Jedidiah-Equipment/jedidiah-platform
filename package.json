{
  "name": "jedidiah-platform",
  "private": true,
  "packageManager": "pnpm@12.8.1+sha512.f64ba907507f5ceafe06c8d38e6052d0179444580ec1279ddd5bfc11cb48aa8a2644b66598e07e761da84872a9fc57d5f902b87fa49d024198d558612aabbe45",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "turbo run dev",
    "dev:kill": "sh scripts/kill-dev-services.sh",
    "dev:kill:all": "sh scripts/kill-dev-services.sh --all",
    "build": "turbo run build",
    "typecheck": "pnpm railway:typecheck && turbo run typecheck",
    "railway:typecheck": "tsc --noEmit --strict --skipLibCheck --target ES2023 --module NodeNext --moduleResolution NodeNext .railway/railway.ts",
    "railway:plan:staging": "railway link --project 'Jedidiah Equipment' --environment staging && railway config plan",
    "railway:apply:staging": "railway link --project 'Jedidiah Equipment' --environment staging && railway config apply",
    "railway:plan:production": "railway link --project 'Jedidiah Equipment' --environment production && railway config plan",
    "railway:apply:production": "railway link --project 'Jedidiah Equipment' --environment production && railway config apply",
    "test": "turbo run test --concurrency=2",
    "lint": "biome check --error-on-warnings",
    "lint:fix": "biome check --write --error-on-warnings",
    "compose:up": "sh scripts/compose-up.sh",
    "compose:down": "sh scripts/compose-down.sh",
    "db:up": "pnpm compose:down && pnpm compose:up && pnpm db:migrate && pnpm db:seed",
    "db:up:template": "pnpm compose:up && pnpm --filter @pkg/db db:up:template",
    "db:create": "pnpm --filter @pkg/db db:create",
    "db:generate": "pnpm --filter @pkg/db db:generate",
    "db:migrate": "pnpm --filter @pkg/db build && pnpm --filter @pkg/db db:migrate",
    "db:migrate:test": "pnpm --filter @pkg/db build && NODE_ENV=test pnpm --filter @pkg/db db:migrate",
    "db:seed": "pnpm --filter @pkg/seed db:seed",
    "db:seed:staging": "pnpm --filter @pkg/seed seed:write:staging",
    "db:studio": "pnpm --filter @pkg/db db:studio",
    "use-slot": "sh scripts/use-slot.sh",
    "mobile:build:staging": "pnpm --filter @pkg/mobile exec node scripts/eas-build.mjs staging",
    "mobile:build:production": "pnpm --filter @pkg/mobile exec node scripts/eas-build.mjs production",
    "release:production": "sh scripts/release-production.sh",
    "release:production:check": "sh scripts/release-production.sh --dry-run",
    "update-package-versions": "pnpm up --recursive --interactive",
    "verify": "pnpm lint && pnpm typecheck && pnpm build && pnpm test"
  },
  "dependencies": {
    "@pkg/schema": "workspace:*",
    "better-auth": "1.7.6",
    "fastify": "^5.12.5",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@railway/cli": "5.63.1",
    "@types/node": "^26.6.3",
    "dotenv": "^18.0.4",
    "railway": "3.12.0",
    "shadcn": "^4.21.0",
    "tsx": "^4.23.15",
    "turbo": "^2.11.5",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  }
}
