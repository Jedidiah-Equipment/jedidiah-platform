{
  "name": "@pkg/mobile",
  "version": "0.0.0",
  "private": true,
  "main": "expo-router/entry",
  "expo": {
    "install": {
      "exclude": [
        "@react-native-async-storage/async-storage",
        "@react-native-community/datetimepicker",
        "@types/react",
        "react",
        "react-dom",
        "react-native-reanimated",
        "react-native-safe-area-context",
        "react-native-screens",
        "react-native-svg",
        "react-native-worklets",
        "typescript"
      ]
    }
  },
  "scripts": {
    "preandroid": "turbo run build --filter=@pkg/api",
    "pretypecheck": "turbo run build --filter=@pkg/api",
    "preios": "turbo run build --filter=@pkg/api",
    "predev": "turbo run build --filter=@pkg/api",
    "android": "APP_VARIANT=staging expo run:android",
    "android:staging-api": "APP_VARIANT=staging EXPO_PUBLIC_API_BASE_URL=https://staging-api.jedidiahequipment.co.za expo run:android",
    "doctor": "APP_VARIANT=staging pnpm dlx expo-doctor",
    "android-eas-submit-production": "APP_VARIANT=production eas build --profile production --platform android --auto-submit",
    "ios-eas-submit-production": "APP_VARIANT=production eas build --profile production --platform ios --auto-submit",
    "android-eas-submit-staging": "APP_VARIANT=staging eas build --profile staging --platform android --auto-submit",
    "ios-eas-submit-staging": "APP_VARIANT=staging eas build --profile staging --platform ios --auto-submit",
    "ota:production": "node scripts/eas-update.mjs production",
    "ota:staging": "node scripts/eas-update.mjs staging",
    "version:bump": "node scripts/bump-version.mjs",
    "eas-build-post-install": "pnpm --workspace-root turbo run build --filter=@pkg/schema --filter=@pkg/domain",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "ios": "APP_VARIANT=staging expo run:ios",
    "ios:staging-api": "APP_VARIANT=staging EXPO_PUBLIC_API_BASE_URL=https://staging-api.jedidiahequipment.co.za expo run:ios",
    "dev": "APP_VARIANT=staging expo start --dev-client",
    "dev:staging-api": "APP_VARIANT=staging EXPO_PUBLIC_API_BASE_URL=https://staging-api.jedidiahequipment.co.za expo start --dev-client --clear",
    "test": "vitest run"
  },
  "dependencies": {
    "@ai-sdk/react": "4.0.126",
    "@better-auth/expo": "1.7.6",
    "@expo/dom-webview": "~57.0.1",
    "@expo/metro-runtime": "~57.0.16",
    "@gluestack-ui/nativewind-utils": "1.0.28",
    "@gluestack-ui/overlay": "0.1.22",
    "@gluestack-ui/switch": "0.1.29",
    "@gluestack-ui/toast": "1.0.9",
    "@legendapp/motion": "2.5.3",
    "@pkg/domain": "workspace:*",
    "@pkg/schema": "workspace:*",
    "@react-native-async-storage/async-storage": "3.1.1",
    "@react-native-community/datetimepicker": "9.2.1",
    "@tabler/icons-react-native": "3.48.0",
    "@tanstack/react-form": "1.33.5",
    "@tanstack/react-query": "5.104.0",
    "@trpc/client": "11.19.0",
    "@trpc/tanstack-react-query": "11.19.0",
    "ai": "7.0.123",
    "better-auth": "1.7.6",
    "expo": "~57.0.26",
    "expo-application": "~57.0.3",
    "expo-asset": "~57.0.18",
    "expo-audio": "~57.0.5",
    "expo-camera": "~57.0.6",
    "expo-clipboard": "~57.0.2",
    "expo-constants": "~57.0.20",
    "expo-dev-client": "~57.0.19",
    "expo-device": "~57.0.2",
    "expo-file-system": "~57.0.7",
    "expo-font": "~57.0.4",
    "expo-image-picker": "~57.0.20",
    "expo-linking": "^57.0.11",
    "expo-localization": "~57.0.2",
    "expo-location": "~57.0.20",
    "expo-media-library": "~57.0.5",
    "expo-network": "~57.0.2",
    "expo-notifications": "~57.0.21",
    "expo-router": "~57.0.24",
    "expo-secure-store": "~57.0.4",
    "expo-sharing": "~57.0.22",
    "expo-status-bar": "^57.0.1",
    "expo-system-ui": "~57.0.4",
    "expo-updates": "~57.0.24",
    "expo-web-browser": "~57.0.3",
    "nativewind": "4.2.7",
    "posthog-react-native": "4.78.2",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.86.3",
    "react-native-blob-util": "0.25.1",
    "react-native-css-interop": "0.2.7",
    "react-native-markdown-display": "7.0.2",
    "react-native-pdf": "7.0.5",
    "react-native-reanimated": "4.5.5",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.28.0",
    "react-native-svg": "15.15.5",
    "react-native-web": "^0.21.3",
    "react-native-worklets": "0.10.4"
  },
  "devDependencies": {
    "@babel/plugin-transform-react-jsx": "7.29.7",
    "@config-plugins/react-native-blob-util": "~14.0.2",
    "@config-plugins/react-native-pdf": "~14.0.2",
    "@pkg/api": "workspace:*",
    "@posthog/cli": "0.18.9",
    "@react-native/metro-config": "0.86.3",
    "@types/react": "~19.3.0",
    "@types/react-test-renderer": "19.3.0",
    "babel-preset-expo": "57.0.13",
    "react-test-renderer": "19.3.0",
    "tailwindcss": "3.4.19",
    "tailwindcss-animate": "1.0.7",
    "typescript": "~7.0.2"
  }
}
