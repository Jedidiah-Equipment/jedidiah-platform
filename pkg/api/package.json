{
  "name": "@pkg/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "build": "tsc -b && tsc-alias -p tsconfig.json",
    "start": "node dist/main.js",
    "translate:backfill": "tsx src/equipment/scripts/translate-backfill.ts",
    "fleet:import": "tsx src/contracting/scripts/fleet-import.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1157.0",
    "@better-auth/drizzle-adapter": "1.7.14",
    "@better-auth/expo": "1.7.14",
    "@fastify/cors": "^11.3.1",
    "@fastify/multipart": "^10.1.6",
    "@pkg/ai": "workspace:*",
    "@pkg/changelog": "workspace:*",
    "@pkg/core": "workspace:*",
    "@pkg/db": "workspace:*",
    "@pkg/domain": "workspace:*",
    "@pkg/integrations": "workspace:*",
    "@pkg/pdf": "workspace:*",
    "@pkg/schema": "workspace:*",
    "@trpc/server": "^11.19.0",
    "dotenv": "^18.0.9",
    "expo-server-sdk": "8.0.0",
    "pino": "^10.4.0",
    "posthog-node": "^5.57.2",
    "resend": "^6.34.1"
  },
  "devDependencies": {
    "@ai-sdk/provider": "4.0.34",
    "ai": "7.0.154",
    "pino-pretty": "^13.2.0",
    "tsc-alias": "^1.9.9",
    "vitest": "^5.0.5"
  }
}
