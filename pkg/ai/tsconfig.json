{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "rootDir": "src",
    "outDir": "dist",
    "composite": true,
    "paths": {
      "@/*": ["./src/*"],
      "@pkg/ai": ["./src/index.ts"],
      "@pkg/ai/equipment": ["./src/equipment/index.ts"],
      "@pkg/ai/contracting": ["./src/contracting/index.ts"],
      "@pkg/core": ["../core/src/index.ts"],
      "@pkg/core/equipment": ["../core/src/equipment/index.ts"],
      "@pkg/core/contracting": ["../core/src/contracting/index.ts"],
      "@pkg/db": ["../db/src/index.ts"],
      "@pkg/db/equipment": ["../db/src/equipment/index.ts"],
      "@pkg/db/contracting": ["../db/src/contracting/index.ts"],
      "@pkg/domain": ["../domain/src/index.ts"],
      "@pkg/domain/equipment": ["../domain/src/equipment/index.ts"],
      "@pkg/domain/contracting": ["../domain/src/contracting/index.ts"],
      "@pkg/domain/testing": ["../domain/src/testing/index.ts"],
      "@pkg/schema": ["../schema/src/index.ts"],
      "@pkg/schema/equipment": ["../schema/src/equipment/index.ts"],
      "@pkg/schema/contracting": ["../schema/src/contracting/index.ts"]
    },
    "types": ["node", "vitest"]
  },
  "include": ["src/**/*.ts"],
  "references": [{ "path": "../schema" }, { "path": "../domain" }, { "path": "../db" }, { "path": "../core" }]
}
