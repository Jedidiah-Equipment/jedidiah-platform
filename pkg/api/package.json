{
  "name": "@pkg/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "build": "tsc -b && tsc-alias -p tsconfig.json",
    "start": "node dist/main.js",
    "translate:backfill": "tsx src/scripts/translate-backfill.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1116.0",
    "@better-auth/drizzle-adapter": "1.7.1",
    "@better-auth/expo": "1.7.1",
    "@fastify/cors": "^11.3.0",
    "@fastify/multipart": "^10.1.1",
    "@pkg/ai": "workspace:*",
    "@pkg/changelog": "workspace:*",
    "@pkg/core": "workspace:*",
    "@pkg/db": "workspace:*",
    "@pkg/domain": "workspace:*",
    "@pkg/pdf": "workspace:*",
    "@pkg/schema": "workspace:*",
    "@trpc/server": "^11.18.0",
    "dotenv": "^17.4.2",
    "pino": "^10.3.1",
    "posthog-node": "^5.50.0",
    "resend": "^6.22.0"
  },
  "devDependencies": {
    "@ai-sdk/provider": "3.0.13",
    "ai": "6.0.221",
    "pino-pretty": "^13.1.3",
    "tsc-alias": "^1.9.2",
    "vitest": "^4.1.11"
  }
}
