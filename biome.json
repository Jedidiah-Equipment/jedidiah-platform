{
  "$schema": "https://biomejs.dev/schemas/2.5.10/schema.json",
  "files": {
    "includes": [
      "**",
      "!**/node_modules",
      "!**/.turbo",
      "!**/dist",
      "!**/dist-server",
      "!**/coverage",
      "!**/.vitepress/cache",
      "!**/.sandcastle/worktrees",
      "!pkg/db/migrations",
      "!pkg/seed/snapshot/products.json",
      "!**/.expo",
      "!pkg/mobile/ios",
      "!pkg/mobile/expo-env.d.ts",
      "!pkg/web/src/app/route-tree.gen.ts",
      "!pkg/lander/src/routeTree.gen.ts",
      "!docs",
      "!scripts",
      "!.claude",
      "!.vscode"
    ]
  },
  "formatter": {
    "enabled": true,
    "formatWithErrors": false,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineEnding": "lf",
    "lineWidth": 120,
    "attributePosition": "auto"
  },
  "css": {
    "parser": {
      "tailwindDirectives": true
    }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "style": {
        "noRestrictedImports": {
          "level": "error",
          "options": {
            "patterns": [
              {
                "group": ["../../*", "../../../*"],
                "message": "Use the @/* alias instead of imports that traverse more than one parent directory."
              }
            ]
          }
        }
      }
    }
  },
  "assist": {
    "enabled": true,
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  },
  "javascript": {
    "formatter": {
      "trailingCommas": "all",
      "semicolons": "always",
      "quoteStyle": "single"
    }
  },
  "overrides": [
    {
      "includes": [
        "pkg/core/src/equipment/**",
        "pkg/api/src/equipment/**",
        "pkg/api/src/routes/equipment/**",
        "pkg/domain/src/equipment/**",
        "pkg/web/src/equipment/**",
        "pkg/web/src/routes/_authed.equipment*",
        "pkg/mobile/app/**/equipment/**",
        "pkg/mobile/src/equipment/**"
      ],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["contracting/**", "**/contracting/**"],
                    "message": "Business namespaces may import shared code, never each other."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": [
        "pkg/core/src/contracting/**",
        "pkg/api/src/contracting/**",
        "pkg/api/src/routes/contracting/**",
        "pkg/domain/src/contracting/**",
        "pkg/web/src/contracting/**",
        "pkg/web/src/routes/_authed.contracting*",
        "pkg/mobile/app/**/contracting/**",
        "pkg/mobile/src/contracting/**"
      ],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["equipment/**", "**/equipment/**", "@pkg/core", "@pkg/domain"],
                    "message": "Business namespaces may import shared code, never each other."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["pkg/lander/src/**/*.test.ts"],
      "linter": {
        "rules": {
          "suspicious": {
            "noDocumentCookie": "off"
          }
        }
      }
    },
    {
      "includes": ["pkg/mobile/**/*.css"],
      "linter": {
        "rules": {
          "suspicious": {
            "noUnknownAtRules": "off"
          }
        }
      }
    }
  ]
}
