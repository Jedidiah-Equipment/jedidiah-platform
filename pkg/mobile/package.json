{
  "name": "@pkg/mobile",
  "version": "0.0.0",
  "private": true,
  "main": "expo-router/entry",
  "expo": {
    "install": {
      "exclude": [
        "@react-native-async-storage/async-storage",
        "react",
        "react-dom",
        "react-native-safe-area-context",
        "react-native-screens",
        "react-native-svg",
        "typescript"
      ]
    }
  },
  "scripts": {
    "preandroid": "turbo run build --filter=@pkg/api",
    "pretypecheck": "turbo run build --filter=@pkg/api",
    "preios": "turbo run build --filter=@pkg/api",
    "predev": "turbo run build --filter=@pkg/api",
    "android": "APP_VARIANT=staging expo run:android",
    "android:staging-api": "APP_VARIANT=staging EXPO_PUBLIC_API_BASE_URL=https://staging-api.jedidiahequipment.co.za expo run:android",
    "doctor": "APP_VARIANT=staging pnpm dlx expo-doctor",
    "android-eas-submit-production": "APP_VARIANT=production eas build --profile production --platform android --auto-submit",
    "ios-eas-submit-production": "APP_VARIANT=production eas build --profile production --platform ios --auto-submit",
    "android-eas-submit-staging": "APP_VARIANT=staging eas build --profile staging --platform android --auto-submit",
    "ios-eas-submit-staging": "APP_VARIANT=staging eas build --profile staging --platform ios --auto-submit",
    "version:bump": "node scripts/bump-version.mjs",
    "eas-build-post-install": "pnpm --workspace-root turbo run build --filter=@pkg/schema --filter=@pkg/domain",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "ios": "APP_VARIANT=staging expo run:ios",
    "ios:staging-api": "APP_VARIANT=staging EXPO_PUBLIC_API_BASE_URL=https://staging-api.jedidiahequipment.co.za expo run:ios",
    "dev": "APP_VARIANT=staging expo start --dev-client",
    "dev:staging-api": "APP_VARIANT=staging EXPO_PUBLIC_API_BASE_URL=https://staging-api.jedidiahequipment.co.za expo start --dev-client --clear",
    "test": "vitest run"
  },
  "dependencies": {
    "@ai-sdk/react": "3.0.223",
    "@better-auth/expo": "1.7.1",
    "@expo/dom-webview": "~57.0.1",
    "@expo/metro-runtime": "~57.0.13",
    "@gluestack-ui/nativewind-utils": "1.0.28",
    "@gluestack-ui/overlay": "0.1.22",
    "@gluestack-ui/switch": "0.1.29",
    "@gluestack-ui/toast": "1.0.9",
    "@legendapp/motion": "2.5.3",
    "@pkg/domain": "workspace:*",
    "@pkg/schema": "workspace:*",
    "@react-native-async-storage/async-storage": "3.1.1",
    "@react-native-community/datetimepicker": "9.1.0",
    "@tabler/icons-react-native": "3.46.0",
    "@tanstack/react-form": "1.33.5",
    "@tanstack/react-query": "5.102.2",
    "@trpc/client": "11.18.0",
    "@trpc/tanstack-react-query": "11.18.0",
    "ai": "6.0.221",
    "better-auth": "1.7.1",
    "expo": "~57.0.16",
    "expo-camera": "~57.0.4",
    "expo-clipboard": "~57.0.1",
    "expo-constants": "~57.0.14",
    "expo-dev-client": "~57.0.15",
    "expo-file-system": "~57.0.5",
    "expo-font": "~57.0.1",
    "expo-linking": "^57.0.7",
    "expo-network": "~57.0.1",
    "expo-router": "~57.0.16",
    "expo-secure-store": "~57.0.1",
    "expo-sharing": "~57.0.15",
    "expo-status-bar": "^57.0.1",
    "expo-system-ui": "~57.0.2",
    "expo-updates": "~57.0.17",
    "expo-web-browser": "~57.0.2",
    "nativewind": "4.2.6",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-native": "0.86.2",
    "react-native-blob-util": "0.24.10",
    "react-native-css-interop": "0.2.6",
    "react-native-markdown-display": "7.0.2",
    "react-native-pdf": "7.0.5",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.9.1",
    "react-native-screens": "~4.27.0",
    "react-native-svg": "15.15.5",
    "react-native-web": "^0.21.2",
    "react-native-worklets": "0.10.1"
  },
  "devDependencies": {
    "@babel/plugin-transform-react-jsx": "7.29.7",
    "@config-plugins/react-native-blob-util": "~14.0.2",
    "@config-plugins/react-native-pdf": "~14.0.2",
    "@pkg/api": "workspace:*",
    "@react-native/metro-config": "0.86.2",
    "@types/react": "~19.2.18",
    "@types/react-test-renderer": "19.1.0",
    "babel-preset-expo": "57.0.8",
    "react-test-renderer": "19.2.8",
    "tailwindcss": "3.4.19",
    "tailwindcss-animate": "1.0.7",
    "typescript": "~7.0.2"
  }
}
