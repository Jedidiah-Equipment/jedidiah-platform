{
  "name": "@pkg/pdf",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./equipment": {
      "types": "./dist/equipment/index.d.ts",
      "import": "./dist/equipment/index.js"
    },
    "./contracting": {
      "types": "./dist/contracting/index.d.ts",
      "import": "./dist/contracting/index.js"
    }
  },
  "scripts": {
    "build": "tsc -b",
    "render:brochure-fixture": "tsx scripts/render-brochure-fixture.ts",
    "render:part-label-fixture": "tsx scripts/render-part-label-fixture.ts",
    "render:purchase-order-fixture": "tsx scripts/render-purchase-order-fixture.ts",
    "render:quote-document-fixture": "tsx scripts/render-quote-document-fixture.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@pkg/domain": "workspace:*",
    "@pkg/schema": "workspace:*",
    "@react-pdf/renderer": "^4.8.1",
    "bwip-js": "4.11.4",
    "pdf-lib": "^1.17.1",
    "react": "19.2.8"
  },
  "devDependencies": {
    "@types/react": "^19.2.18",
    "vitest": "^4.1.11"
  }
}
